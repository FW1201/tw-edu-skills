{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "language",
    "context",
    "sources",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "tw-edu-material-reviewer"
    },
    "language": {
      "const": "zh-TW"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "topic"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "pending"
            ]
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "material",
            "assessment",
            "slides"
          ]
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text"
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "material_id": {
                "type": "string",
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "confirmed",
                  "unknown",
                  "resolved"
                ]
              },
              "severity": {
                "enum": [
                  "blocking",
                  "warning",
                  "info",
                  "unknown"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "source_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "material_id",
              "quote",
              "status",
              "severity",
              "reason",
              "revision",
              "source_ids"
            ]
          }
        },
        "unchecked": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "title",
        "mode",
        "materials",
        "findings",
        "unchecked"
      ]
    }
  }
}
