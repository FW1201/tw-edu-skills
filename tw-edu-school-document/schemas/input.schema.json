{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "language",
    "context",
    "sources",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "tw-edu-school-document"
    },
    "language": {
      "const": "zh-TW"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "topic"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "pending"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "document_type",
        "approval_status",
        "basis",
        "purpose",
        "implementation",
        "responsible_people",
        "expected_results"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "enum": [
            "活動計畫",
            "補助申請計畫",
            "成果報告",
            "校內辦法草案",
            "實施計畫",
            "其他"
          ]
        },
        "approval_status": {
          "enum": [
            "草稿",
            "簽核中",
            "已核定"
          ]
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "implementation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "details"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "responsible_people": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "schedule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "item"
            ],
            "properties": {
              "date": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "budget": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "amount",
              "unit",
              "basis"
            ],
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "basis": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "total_budget": {
          "type": "number",
          "minimum": 0
        },
        "funding_source": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "indicator",
              "target",
              "actual",
              "evidence"
            ],
            "properties": {
              "indicator": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "actual": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pending": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
