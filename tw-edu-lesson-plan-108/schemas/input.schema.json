{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "language",
    "context",
    "sources",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "tw-edu-lesson-plan-108"
    },
    "language": {
      "const": "zh-TW"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "topic"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "pending"
            ]
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "total_minutes",
        "objectives",
        "activities",
        "assessments"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "total_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "minutes",
              "instructions",
              "objective_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "minutes": {
                "type": "integer",
                "minimum": 1
              },
              "instructions": {
                "type": "string",
                "minLength": 1
              },
              "objective_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "assessments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "method",
              "criteria",
              "objective_ids"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "string",
                "minLength": 1
              },
              "objective_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "curriculum_codes": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "description",
              "verified"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "verified": {
                "type": "boolean"
              },
              "verification_note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mode": {
          "enum": [
            "單節",
            "單元",
            "多節"
          ]
        },
        "learning_focus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "performance",
            "content"
          ],
          "properties": {
            "performance": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "content": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "differentiation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
