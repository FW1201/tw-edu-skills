{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "language",
    "context",
    "sources",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "tw-edu-math-composing"
    },
    "language": {
      "const": "zh-TW"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "topic"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "pending"
            ]
          }
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "title",
        "purpose",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "layout": {
          "type": "object"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "heading": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "answer": {
                "type": "string"
              },
              "group_heading": {
                "type": "string"
              },
              "parent_heading": {
                "type": "string"
              },
              "page_break": {
                "type": "boolean"
              },
              "column_break": {
                "type": "boolean"
              },
              "subquestion": {
                "type": "boolean"
              },
              "workspace_mm": {
                "type": "integer"
              },
              "answer_lines": {
                "type": "integer"
              },
              "formula": {
                "type": "object",
                "required": [
                  "latex",
                  "parts"
                ],
                "additionalProperties": false,
                "properties": {
                  "latex": {
                    "type": "string"
                  },
                  "parts": {
                    "type": "array",
                    "minItems": 1
                  },
                  "answer_blank": {
                    "type": "boolean"
                  }
                }
              },
              "figure": {
                "type": "object",
                "required": [
                  "size",
                  "alt"
                ]
              },
              "table": {
                "type": "array",
                "minItems": 1
              },
              "prompt_parts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "math"
                      ],
                      "properties": {
                        "math": {
                          "type": "array",
                          "minItems": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "answer_parts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "text"
                      ],
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "math"
                      ],
                      "properties": {
                        "math": {
                          "type": "array",
                          "minItems": 1
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
