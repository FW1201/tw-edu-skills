{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "language",
    "context",
    "sources",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "tw-edu-conduct-comments"
    },
    "language": {
      "const": "zh-TW"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "grade",
        "topic"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "status"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "verified",
              "user_provided",
              "pending"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "school_level",
        "students"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "school_level": {
          "enum": [
            "國民小學",
            "國民中學",
            "高級中等學校"
          ]
        },
        "students": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "student_id",
              "evidence",
              "comment",
              "evidence_ids",
              "suggestion"
            ],
            "properties": {
              "student_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 12
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "aspect",
                    "date",
                    "observation"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "aspect": {
                      "enum": [
                        "出缺席",
                        "獎懲",
                        "團體活動",
                        "品德言行",
                        "公共服務",
                        "校內外特殊表現"
                      ]
                    },
                    "date": {
                      "type": "string",
                      "minLength": 1
                    },
                    "observation": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "comment": {
                "type": "string",
                "minLength": 1
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "suggestion": {
                "type": "string",
                "minLength": 1
              },
              "parent_version": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
